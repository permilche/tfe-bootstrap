# TFE Organization Configuration
organization_name  = "your-tfe-org-here"
organization_email = "your-tfe-email-here"

# Set via environment variable: export TF_VAR_tfe_token="your-tfe-token-here"
tfe_token = "your-tfe-token-here"
tfe_hostname = "app.terraform.io" # HCP Terraform FQDN (use your TFE FQDN if self-hosted)

# Azure DevOps VCS Configuration
vcs_oauth_token_id = "your-vcs-manually-created-oauth-token-id-here"
vcs_https_url      = "your-azure-devops-https-url-here"
vcs_api_url       = "your-azure-devops-api-url-here"
vcs_organization  = "your-azure-devops-org-here"
vcs_project       = "your-azure-devops-proj-here"
vcs_repository_management    = "tfe-management"  
vcs_repository_private_registry = "tfe-private-registry"

# Dynamic Credentials Azure Configuration
# Add one entry per subscription. The map key IS the display name, the provider alias,
# and the TAG suffix in TFC_AZURE_* env vars (uppercased). To add a new subscription,
# create a new dynamic-credentials-azure-<key>.tf file and add an entry here.
azure_subscriptions = {
  "your-subscription-name-here" = {
    subscription_id = "your-subscription-id-here"
    tenant_id       = "your-tenant-id-here"
  }
  # "your-second-subscription-name-here" = {
  #   subscription_id = "your-second-subscription-id-here"
  #   tenant_id       = "your-tenant-id-here"
  # }
}

# Azure Communication Services (SMTP). The resource group must already exist
resource_group_name     = "your-resource-group-here"
smtp_username           = "your-smtp-username-here"
smtp_test_email_address = "your-test-email-address-here"

# Workspace Configuration
vcs_branch_management       = "main"
vcs_branch_private_registry = "main"
terraform_version  = "1.5.0"
auto_apply         = false  # Set to true for automatic applies (not recommended for production)
working_directory  = ""     # Leave empty if Terraform files are in repository root

# Optional: Notification Configuration
# Uncomment and configure if you want Slack/email notifications
# notification_configurations = {
#   slack = {
#     destination_type = "slack"
#     url              = "https://hooks.slack.com/services/YOUR/WEBHOOK/URL"
#     triggers         = ["run:errored", "run:completed", "run:needs_attention"]
#   }
# }

ssh_private_key = <<EOT
-----BEGIN RSA PRIVATE KEY-----
...
-----END RSA PRIVATE KEY-----
EOT